#!/bin/sh

. /usr/share/libubox/jshn.sh

runtime=/var/run/exconnect
control=/usr/libexec/exconnect/control

error_reply() {
	json_init
	json_add_boolean ok 0
	json_add_string error "$1"
	json_dump
}

probe_reply() {
	local section kind section_type kind_type
	json_load "$(cat)" || { error_reply 'Invalid connection test request.'; return; }
	json_get_type section_type section
	json_get_type kind_type kind
	if [ "$section_type" != string ] || [ "$kind_type" != string ]; then
		error_reply 'Invalid connection test request.'
		return
	fi
	json_get_var section section
	json_get_var kind kind
	/usr/libexec/exconnect/probe "$section" "$kind"
}

upload_reply() {
	local name token name_type token_type
	json_load "$(cat)" || { error_reply 'Invalid DAT upload request.'; return; }
	json_get_type name_type name
	json_get_type token_type token
	if [ "$name_type" != string ] || [ "$token_type" != string ]; then
		error_reply 'Invalid DAT upload request.'
		return
	fi
	json_get_var name name
	json_get_var token token
	/usr/libexec/exconnect/assets upload "$name" "$token"
}

discard_upload_reply() {
	local token token_type
	json_load "$(cat)" || { error_reply 'Invalid DAT upload request.'; return; }
	json_get_type token_type token
	if [ "$token_type" != string ]; then
		error_reply 'Invalid DAT upload request.'
		return
	fi
	json_get_var token token
	/usr/libexec/exconnect/assets cancel_upload "$token"
}

logs_reply() {
	local log previous_error
	log="$(logread -l 500 -e '^exconnect' 2>/dev/null)" || { error_reply 'Could not read the system log.'; return; }
	log="$(printf '%s\n' "$log" | awk '$7 ~ /^exconnect(-core)?(\[[0-9]+\])?:$/' | tail -n 80)"
	previous_error="$(cat "$runtime/last_error" 2>/dev/null || :)"
	if [ -n "$previous_error" ]; then
		log="${log}${log:+
}ExConnect: $previous_error"
	fi
	log="$(printf '%s\n' "$log" | sed -E 's#([[:alnum:]+.-]+://)[^[:space:]]+#\1[redacted]#g')"
	json_init
	json_add_boolean ok 1
	json_add_string log "$log"
	json_dump
}

action_reply() {
	local action="$1" value error
	json_init
	value="$("$control" "$action" 2>/dev/null)"
	if [ "$?" -eq 0 ]; then
		json_add_boolean ok 1
		[ "$action" != update_assets ] || json_add_int updated "$value"
	else
		json_add_boolean ok 0
		error="$(cat "$runtime/last_error" 2>/dev/null)"
		json_add_string error "${error:-ExConnect operation failed. Check the system log.}"
	fi
	json_dump
}

status_reply() {
	local enabled=0 running=0 version profile error pid
	[ "$(uci -q -C '' -P "$runtime" get exconnect.main.enabled)" != 1 ] || enabled=1
	if read -r pid 2>/dev/null <"$runtime/ready" && kill -0 "$pid" 2>/dev/null; then
		running=1
	fi
	version="$(/usr/bin/xray version 2>/dev/null | head -n 1)"
	profile="$(uci -q -C '' -P "$runtime" get exconnect.main.profile)"
	error="$(cat "$runtime/last_error" 2>/dev/null)"
	json_init
	json_add_boolean enabled "$enabled"
	json_add_boolean running "$running"
	[ -z "$version" ] || json_add_string version "$version"
	[ -z "$profile" ] || json_add_string profile "$profile"
	[ -z "$error" ] || json_add_string last_error "$error"
	json_dump
}

case "$1:$2" in
	list:)
		printf '%s\n' '{"status":{},"apply":{},"stop":{},"validate":{},"update_assets":{},"assets_status":{},"prepare_asset_upload":{},"discard_asset_upload":{"token":""},"upload_asset":{"name":"","token":""},"probe":{"section":"","kind":""},"logs":{}}'
		;;
	call:status)
		status_reply
		;;
	call:probe)
		probe_reply
		;;
	call:logs)
		logs_reply
		;;
	call:update_assets)
		/usr/libexec/exconnect/assets start
		;;
	call:assets_status)
		/usr/libexec/exconnect/assets status
		;;
	call:prepare_asset_upload)
		/usr/libexec/exconnect/assets prepare_upload
		;;
	call:upload_asset)
		upload_reply
		;;
	call:discard_asset_upload)
		discard_upload_reply
		;;
	call:apply|call:stop|call:validate)
		action_reply "$2"
		;;
	*)
		exit 2
		;;
esac
