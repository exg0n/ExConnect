#!/bin/sh

runtime=/var/run/exconnect
asset_root=/etc/exconnect
assets="$asset_root/geo"
generator=/usr/libexec/exconnect/generate.uc
service=/etc/init.d/exconnect
umask 077

mkdir -p "$runtime" "$asset_root" || exit 1
chmod 700 "$runtime" "$asset_root" || exit 1

is_enabled() {
	[ "$(uci -q -C '' -P "$runtime" get exconnect.main.enabled)" = 1 ]
}

fail() {
	printf '%s\n' "$1" >&2
	printf '%s\n' "$1" >"$runtime/last_error"
	return 1
}

validate_config() {
	local json="$1" rules="$2" geo="$3" detail missing
	detail="$(ucode "$generator" generate 2>&1 >"$json")" ||
		{ fail "$detail"; return 1; }
	detail="$(ucode "$generator" nftables 2>&1 >"$rules")" ||
		{ fail "$detail"; return 1; }
	if [ -s "$rules" ] && ! nft --check --file "$rules" >&2; then
		fail "The firewall rejected the transparent routing configuration."
		return 1
	fi
	mkdir -p "$geo" || { fail "Could not create DAT directory"; return 1; }
	if detail="$(XRAY_LOCATION_ASSET="$geo" /usr/bin/xray run -test -config "$json" 2>&1)"; then
		printf '%s\n' "$detail" >&2
		return 0
	fi
	printf '%s\n' "$detail" >&2
	# Log routing failures without copying profile parser output into syslog.
	detail="$(printf '%s\n' "$detail" | grep -m 1 -F 'failed to build routing configuration' |
		sed -E 's#([[:alnum:]+.-]+://)[^[:space:]]+#\1[redacted]#g')"
	if [ -n "$detail" ]; then
		logger -t exconnect "Configuration check failed: $detail"
		if printf '%s\n' "$detail" | grep -Fq 'no such file or directory'; then
			missing="$(printf '%s\n' "$detail" | sed -nE 's/.*failed to open (file: )?([a-zA-Z0-9][a-zA-Z0-9_.-]*\.dat).*/\2/p')"
			if [ -n "$missing" ]; then
				fail "Rule data file $missing is missing. Download the configured files in Rule data, then check the configuration again."
				return 1
			fi
		fi
		detail="$(printf '%s\n' "$detail" | sed -E 's/^.*failed to build routing configuration > //')"
		fail "Xray could not load the routing rules. $detail"
		return 1
	fi
	fail "Xray rejected the configuration. Check the settings and DAT tags."
}

prepare() {
	local stage result=0
	stage="$(mktemp -d "$runtime/prepare.XXXXXX")" || return 1
	validate_config "$stage/config.json" "$stage/lan.nft" "$assets" &&
		install_config "$stage" && rm -f "$runtime/last_error" || result=1
	rm -rf "$stage"
	return "$result"
}

install_config() {
	mv -f "$1/lan.nft" "$runtime/lan.nft" &&
		mv -f "$1/config.json" "$runtime/config.json" ||
		fail "Could not install the runtime configuration"
}

validate() {
	local stage result=0
	stage="$(mktemp -d "$runtime/validate.XXXXXX")" || return 1
	validate_config "$stage/config.json" "$stage/lan.nft" "$assets" || result=1
	rm -rf "$stage"
	return "$result"
}

stop() {
	"$service" stop || :
	if ! (flock -w 6 8) 8>"$runtime/core.lock"; then
		fail "Xray did not stop in time"
		return 1
	fi
	rm -f "$runtime/ready" "$runtime/last_error"
}

start_prepared() {
	"$service" start prepared || { fail "Could not register Xray with procd"; return 1; }
	local attempt=0
	while [ "$attempt" -lt 12 ]; do
		[ ! -s "$runtime/ready" ] || return 0
		[ ! -s "$runtime/last_error" ] || return 1
		sleep 1
		attempt=$((attempt + 1))
	done
	fail "Xray startup timed out"
}

apply() {
	if ! is_enabled; then
		stop
		return "$?"
	fi

	local backup error
	stage="$(mktemp -d "$runtime/apply.XXXXXX")" || return 1
	trap 'rm -rf "$stage"' EXIT
	validate_config "$stage/config.json" "$stage/lan.nft" "$assets" || return 1
	backup="$stage/previous"
	if [ -s "$runtime/ready" ]; then
		mkdir "$backup" &&
			cp "$runtime/config.json" "$runtime/lan.nft" "$backup/" || return 1
	fi

	stop || return 1
	if install_config "$stage" && start_prepared; then
		return 0
	fi

	error="$(cat "$runtime/last_error" 2>/dev/null)"
	stop || return 1
	if [ -d "$backup" ]; then
		if ! install_config "$backup" || ! "$service" start prepared; then
			fail "Could not restart the previous Xray configuration"
			return 1
		fi
	fi
	[ -n "$error" ] || error="Could not start Xray"
	fail "$error"
}

commit_assets() {
	local stage="$1" previous pid
	case "$stage" in /etc/exconnect/geo-update.??????) ;; *) fail 'Invalid rule data task.'; return 1 ;; esac
	[ -d "$stage/data" ] && [ ! -L "$stage" ] || { fail 'The staged rule data is missing.'; return 1; }
	ucode "$generator" asset_snapshot > "$stage/config.current" || return 1
	if [ "$(cat "$stage/config.snapshot")" != "$(cat "$stage/config.current")" ]; then
		fail 'The rule data sources changed during the task. Start the task again.'
		return 1
	fi
	# Individually valid lists can be uploaded before all saved rules are ready.
	# Keep the current generation when a running service's rules would reject it.
	if read -r pid 2>/dev/null < "$runtime/ready" && kill -0 "$pid" 2>/dev/null; then
		if ! XRAY_LOCATION_ASSET="$stage/data" /usr/bin/xray run -test -config "$runtime/config.json" >/dev/null 2>&1; then
			fail 'The new rule data does not match the running configuration. Stop the service before replacing incompatible lists.'
			return 1
		fi
		validate_config "$stage/config.json" "$stage/lan.nft" "$stage/data" || return 1
	fi
	previous="$stage/previous"
	if [ -d "$assets" ]; then
		mv "$assets" "$previous" || return 1
	fi
	if ! mv "$stage/data" "$assets"; then
		if [ -d "$previous" ] && ! mv "$previous" "$assets"; then
			fail "Could not restore DAT files. The previous generation is retained in $previous."
			return 1
		fi
		fail "Could not install DAT files"
		return 1
	fi
	rm -f "$runtime/last_error"
}

case "$1" in
	prepare)
		prepare
		;;
	update_assets)
		exec /usr/libexec/exconnect/assets sync
		;;
	validate|apply|commit_assets|stop)
		exec 9>"$runtime/control.lock"
		flock -w 3 9 || { fail "Another ExConnect operation is running"; exit 1; }
		case "$1" in
			validate) validate ;;
			apply) apply ;;
			commit_assets) commit_assets "$2" ;;
			stop) stop ;;
		esac
		;;
	*)
		exit 2
		;;
esac
