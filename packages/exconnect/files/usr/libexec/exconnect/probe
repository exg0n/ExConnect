#!/bin/sh

. /usr/share/libubox/jshn.sh

fail() {
	json_init
	json_add_boolean ok 0
	json_add_string error "$1"
	json_dump
	exit 0
}

section=${1:-}
kind=${2:-}
case "$section" in
	''|*[!a-zA-Z0-9_]*) fail 'Select a saved connection profile.' ;;
esac
case "$kind" in
	latency) size=0 ;;
	speed) size=2000000 ;;
	*) fail 'Unknown connection test.' ;;
esac

runtime=/var/run/exconnect
umask 077
mkdir -p "$runtime" || fail 'Could not prepare the diagnostics directory.'
exec 9>"$runtime/probe.lock"
flock -n 9 || fail 'A connection test is already running.'

workdir=$(mktemp -d "$runtime/probe.XXXXXX") || fail 'Could not prepare the diagnostics directory.'
pid=
cleanup() {
	if [ -n "$pid" ]; then
		kill "$pid" 2>/dev/null || :
		wait "$pid" 2>/dev/null || :
	fi
	rm -rf "$workdir"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# Leave the service and firewall untouched. Confirm the test owns the listener.
port=18900
while [ "$port" -lt 18916 ]; do
	listeners=$(ss -H -ltn "sport = :$port" 2>/dev/null) || fail 'Could not inspect local listeners.'
	[ -n "$listeners" ] || break
	port=$((port + 1))
done
[ "$port" -lt 18916 ] || fail 'No local diagnostics port is available.'
if ! ucode /usr/libexec/exconnect/generate.uc probe "$section" "$port" >"$workdir/config.json" 2>/dev/null; then
	fail 'Could not build the test configuration. Check the saved profile.'
fi

/usr/bin/xray run -config "$workdir/config.json" >/dev/null 2>&1 9>&- &
pid=$!
attempt=0
while [ "$attempt" -lt 4 ]; do
	kill -0 "$pid" 2>/dev/null || fail 'Xray rejected the test profile or could not start.'
	if ss -H -ltnp "sport = :$port" 2>/dev/null | grep -Fq "pid=$pid,"; then
		break
	fi
	sleep 1
	attempt=$((attempt + 1))
done
[ "$attempt" -lt 4 ] || fail 'The temporary Xray listener did not start.'

curl_result=0
stats=$(LC_ALL=C curl -q --fail --silent --noproxy '' \
	--proxy "socks5h://127.0.0.1:$port" --proto '=https' \
	--connect-timeout 5 --max-time 12 --max-filesize 2000000 \
	--output /dev/null --write-out '%{http_code} %{time_starttransfer} %{speed_download} %{size_download}' \
	"https://speed.cloudflare.com/__down?bytes=$size") || curl_result=$?
if [ "$curl_result" -ne 0 ] && { [ "$kind" != speed ] || [ "$curl_result" -ne 28 ]; }; then
	fail 'The test endpoint could not be reached through this profile.'
fi

metrics=$(printf '%s\n' "$stats" | LC_ALL=C awk -v bytes="$size" -v status="$curl_result" '
	NF == 4 && $1 == 200 && $2 ~ /^[0-9]+([.][0-9]+)?$/ &&
	$3 ~ /^[0-9]+([.][0-9]+)?$/ && $4 ~ /^[0-9]+$/ &&
	((status == 0 && $4 == bytes) ||
	 (status == 28 && $4 > 0 && $4 <= bytes && $3 > 0)) {
		printf "%.0f %.3f %d\n", $2 * 1000, $3 * 8 / 1000000, $4
	}')
[ -n "$metrics" ] || fail 'The test endpoint returned an unexpected response.'
read -r delay speed downloaded <<EOF
$metrics
EOF

json_init
json_add_boolean ok 1
if [ "$kind" = latency ]; then
	json_add_int latency_ms "$delay"
else
	json_add_double speed_mbps "$speed"
	json_add_int bytes "$downloaded"
fi
json_dump
