#!/bin/sh /etc/rc.common

USE_PROCD=1

start_service() {
	case "$1" in
		/etc/exconnect/geo-update.??????) ;;
		*) return 1 ;;
	esac
	[ -d "$1" ] && [ ! -L "$1" ] || return 1
	procd_open_instance assets
	procd_set_param command /usr/libexec/exconnect/assets run "$1"
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
