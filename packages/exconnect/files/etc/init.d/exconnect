#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	if [ "$1" != prepared ]; then
		[ "$(uci -q -C '' -P /var/run/exconnect get exconnect.main.enabled)" = 1 ] || return 0
		/usr/libexec/exconnect/control prepare || return 1
	fi

	procd_open_instance core
	procd_set_param command /usr/libexec/exconnect/run
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	:
}
